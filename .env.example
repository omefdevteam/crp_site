# --- Neon Postgres (Vercel > Storage > Neon provides this) ---
DATABASE_URL=

# --- Public origin of the deployment (used in emailed links; HTTPS in production) ---
APP_URL=https://your-domain

# --- Resend (transactional email on your verified sending domain) ---
RESEND_API_KEY=
RESEND_FROM="Climate Refugee Pavilion <apply@your-domain>"
# Signing secret of the Resend webhook pointed at /api/webhooks/resend (whsec_...).
RESEND_WEBHOOK_SECRET=

# --- Secrets (each 32+ random characters in production) ---
# Signs applicant sessions, rate-limit keys, and recovery tokens.
APP_SECRET=
# Team access to /api/ops (overview of stuck work + recovery actions).
OPERATIONS_SECRET=
# Vercel Cron sends this as a bearer token to /api/cron/jobs (the job worker).
CRON_SECRET=
# Shared secret guarding the Power Automate sync endpoints.
SYNC_API_SECRET=

# --- Excel review workbook (optional; /api/cron/excel skips when any value is unset) ---
# Entra app with Microsoft Graph application permission Files.ReadWrite.All, admin-consented.
# Never put the client secret in the workbook or in git.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# CRP-Review.xlsx in SharePoint or OneDrive for Business. Resolve the ids once:
# GET https://graph.microsoft.com/v1.0/sites/{hostname}:/sites/{site}:/drive/root:/CRP-Review.xlsx
# parentReference.driveId is GRAPH_DRIVE_ID. id is GRAPH_ITEM_ID.
# GRAPH_DRIVE_ID=
# GRAPH_ITEM_ID=

# --- VideoAsk ---
# One shared secret, sent by every form as the x-webhook-secret header.
VIDEOASK_WEBHOOK_SECRET=
# One form per stage per language (the pre-application popup picks the language).
VIDEOASK_ROUND1_URL_EN=
VIDEOASK_ROUND1_URL_FR=
VIDEOASK_ROUND2_URL_EN=
VIDEOASK_ROUND2_URL_FR=

# --- Identity check after Round 1 (provider-agnostic; swap by env only) ---
# didit (free tier, default) or smileid (adapter seam, not yet implemented).
IDENTITY_PROVIDER=didit
# Didit (https://didit.me): API key + workflow create the session; the shared
# secret verifies the webhook signature.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Smile ID (only when IDENTITY_PROVIDER=smileid):
# SMILE_PARTNER_ID=
# SMILE_API_KEY=

# --- Eligibility window, in years (the program is for 19-26 year olds) ---
MIN_APPLICANT_AGE=19
MAX_APPLICANT_AGE=26

# --- Consent record version stamped on each applicant ---
CONSENT_VERSION=v1

# --- Cloudflare Turnstile (spam protection on public forms) ---
# Public site key (rendered in the browser) + secret key (server-side verify).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
